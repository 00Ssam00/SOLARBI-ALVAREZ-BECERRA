     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT hora_id::text AS \"Hora local\", AVG(pv_w_prom) AS \"FV promedio (W)\" FROM gold.fact_lectura_5min WHERE $__timeFilter(bloque_ts) AND inversor_id IN (${inversor:csv}) GROUP BY hora_id ORDER BY hora_id"
