 },
 "panels": [
  {
   "id": 101,
   "type": "row",
   "title": "Histórico (usa el rango de tiempo del tablero y el filtro de inversor)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Energía FV diaria: integrada vs contador del equipo",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "solarbi-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "solarbi-pg"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT d.fecha::timestamp AS time, SUM(f.pv_kwh_integrado) AS \"Integrada (kWh)\", SUM(f.pv_kwh_equipo) AS \"Contador del equipo (kWh)\" FROM gold.fact_energia_dia f JOIN gold.dim_fecha d USING (fecha_id) WHERE $__timeFilter(d.fecha) AND f.inversor_id IN (${inversor:csv}) GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "La diferencia es la conciliación: el contador cuenta el día completo; la integración solo ve donde hay lecturas."
  },
  {
   "id": 8,
   "type": "barchart",
   "title": "Perfil horario de potencia FV (promedio)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "solarbi-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "solarbi-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT hora_id::text AS \"Hora local\", AVG(pv_w_prom) AS \"FV promedio (W)\" FROM gold.fact_lectura_5min WHERE $__timeFilter(bloque_ts) AND inversor_id IN (${inversor:csv}) GROUP BY hora_id ORDER BY hora_id"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watt"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "SOC mínimo por periodo (agrupación: ${agrupacion})",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "solarbi-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "solarbi-pg"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT date_trunc('${agrupacion}', bloque_ts) AS time, 'Inversor ' || inversor_id AS metric, MIN(soc_min) AS value FROM gold.fact_lectura_5min WHERE $__timeFilter(bloque_ts) AND inversor_id IN (${inversor:csv}) GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Eventos de alarma por día",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "solarbi-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "solarbi-pg"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT date_trunc('day', inicio_ts) AS time, 'Inversor ' || inversor_id AS metric, COUNT(*) AS value FROM gold.fact_evento_alarma WHERE $__timeFilter(inicio_ts) AND inversor_id IN (${inversor:csv}) GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 102,
   "type": "row",
   "title": "Calidad del dato (última corrida del ETL)",
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
