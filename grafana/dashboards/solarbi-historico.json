   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 11,
   "type": "table",
   "title": "Conteos por regla de calidad",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "solarbi-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 10,
    "h": 15
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "solarbi-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT regla AS \"Regla\", accion AS \"Acción\", SUM(filas_afectadas) AS \"Filas\" FROM etl.regla_calidad WHERE corrida_id = (SELECT MAX(corrida_id) FROM etl.corrida WHERE estado = 'ok') GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "table",
   "title": "Conciliación Bronze → Silver → Gold",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "solarbi-pg"
   },
   "gridPos": {
    "x": 10,
    "y": 18,
    "w": 14,
    "h": 15
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "solarbi-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT control AS \"Control\", inversor_id AS \"Inversor\", valor_origen AS \"Origen\", valor_destino AS \"Destino\", cuadra AS \"Cuadra\" FROM etl.conciliacion WHERE corrida_id = (SELECT MAX(corrida_id) FROM etl.corrida WHERE estado = 'ok') ORDER BY 1, 2"
    }
   ],
   "fieldConfig": {
    "defaults": {},
