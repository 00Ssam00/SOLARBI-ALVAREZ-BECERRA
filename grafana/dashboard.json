    {
      "id": 1,
      "type": "stat",
      "title": "Energía total del rango (kWh)",
      "description": "Suma de fact_energia_dia en el rango de tiempo del tablero.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(e.energia_kwh), 0) AS \"Energía total\"\nFROM dwh.fact_energia_dia e\nJOIN dwh.dim_fecha f ON f.fecha_key = e.fecha_key\nJOIN dwh.dim_dispositivo d ON d.dispositivo_key = e.dispositivo_key\nWHERE $__timeFilter(f.fecha::timestamp AT TIME ZONE 'America/Bogota')\n  AND d.dispositivo_id = ${dispositivo}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Energía del día seleccionado (kWh)",
      "description": "Energía del día elegido en la variable «Día» (potencia × 5/60 h de las lecturas válidas).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
