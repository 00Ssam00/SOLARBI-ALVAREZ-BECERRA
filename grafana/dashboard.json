      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT f.fecha::text AS \"Fecha\", e.energia_kwh AS \"Energía (kWh)\"\nFROM dwh.fact_energia_dia e\nJOIN dwh.dim_fecha f ON f.fecha_key = e.fecha_key\nJOIN dwh.dim_dispositivo d ON d.dispositivo_key = e.dispositivo_key\nWHERE $__timeFilter(f.fecha::timestamp AT TIME ZONE 'America/Bogota')\n  AND d.dispositivo_id = ${dispositivo}\nORDER BY f.fecha"
