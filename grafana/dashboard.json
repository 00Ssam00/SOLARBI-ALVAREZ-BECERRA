      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(ts, '1h'),\n  AVG(p_ac_kw) AS \"Potencia promedio (kW)\"\nFROM silver.lectura_5min\nWHERE $__timeFilter(ts) AND dispositivo_id = ${dispositivo}\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
