            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.energia_kwh AS \"Energía del día\"\nFROM dwh.fact_energia_dia e\nJOIN dwh.dim_fecha f ON f.fecha_key = e.fecha_key\nJOIN dwh.dim_dispositivo d ON d.dispositivo_key = e.dispositivo_key\nWHERE e.fecha_key = ${dia} AND d.dispositivo_id = ${dispositivo}"
        }
      ]
    },
